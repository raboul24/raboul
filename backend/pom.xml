<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the journal's Java backend.
  - Java 21 (LTS).
  - Spring Boot 3.3.5 is pinned through the parent POM; it also pins matching versions of
    Jackson (JSON), Tomcat (web server) and JUnit 5 (tests), so we do not list those versions ourselves.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.raboul</groupId>
  <artifactId>journal-backend</artifactId>
  <version>1.0.0</version>
  <name>journal-backend</name>
  <description>REST API that saves, loads and searches the calendar journal</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- Web server + REST controllers + JSON (Jackson). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- JUnit 5, Mockito and MockMvc for the tests. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Adds `mvn spring-boot:run` and builds a runnable jar with `mvn package`. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
